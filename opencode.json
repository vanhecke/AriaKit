{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "mcp": {
    "xcode": {
      "type": "local",
      "command": ["xcrun", "mcpbridge"],
      "enabled": true
    },
    "XcodeBuildMCP": {
      "type": "local",
      "command": ["npx", "-y", "xcodebuildmcp@2.7.0", "mcp"],
      "enabled": true,
      "environment": {
        "XCODEBUILDMCP_ENABLED_WORKFLOWS": "session-management,project-discovery,macos,swift-package,xcode-ide,utilities,coverage,debugging,ui-automation"
      }
    },
    "apple-docs": {
      "type": "local",
      "command": ["npx", "-y", "@kimsungwhee/apple-docs-mcp@1.0.26"],
      "enabled": true
    }
  }
}
